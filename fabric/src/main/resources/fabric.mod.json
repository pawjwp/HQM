{
  "schemaVersion": 1,
  "id": "hardcorequesting",
  "version": "${version}",
  "name": "Hardcore Questing Mode",
  "description": "A questing system that modpacks can use to guide players or reward progress, with support for teams, lives, loot bags and reputations.",
  "authors": [
    "Vswe",
    "Lorddusk",
    "Newcastlegeek",
    "Way2muchnoise",
    "McJty",
    "canitzp",
    "ArclightTW",
    "shedaniel",
    "kirderf1",
    "CodexAdrian",
    "pawjwp"
  ],
  "contact": {
    "sources": "https://github.com/pawjwp/HQM",
    "issues": "https://github.com/pawjwp/HQM/issues"
  },
  "license": "LGPL-3.0-only",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "hardcorequesting.fabric.HardcoreQuestingFabric"
    ],
    "fabric-gametest": [
      "hardcorequesting.fabric.HQMTest"
    ],
    "cardinal-components": [
      "hardcorequesting.fabric.capabilities.ModCapabilities"
    ],
    "jei_mod_plugin": [
      "hardcorequesting.common.client.integration.HQMJeiPlugin"
    ]
  },
  "mixins": [
    "hardcorequesting.mixins.json"
  ],
  "accessWidener": "hqm.accesswidener",
  "depends": {
    "fabricloader": ">=0.16.14",
    "fabric-api": ">=0.92.12",
    "minecraft": "1.20.1",
    "java": ">=17",
    "architectury": ">=9.1.12 <10",
    "cardinal-components-base": ">=5",
    "cardinal-components-entity": ">=5"
  },
  "custom": {
    "cardinal-components": [
      "hardcorequesting:player_extra_data"
    ]
  }
}